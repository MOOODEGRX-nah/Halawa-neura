{
  "index.html": "<!doctype html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>سيرة ذاتية</title><link rel=\"stylesheet\" href=\"style.css\"><script src=\"script.js\" defer></script></head><body><header><h1>الاسم الكامل هنا</h1><button type=\"button\" id=\"cv-font-toggle\" aria-controls=\"cv-content\" aria-pressed=\"false\">تكبير الخط</button></header><main id=\"cv-content\"><h2>نبذة عني</h2><p>اكتب نبذة تعريفية قصيرة هنا.</p><h2>المهارات</h2><ul><li>مهارة أولى هنا</li><li>مهارة ثانية هنا</li></ul><h2>التواصل</h2><p>أضف بيانات التواصل هنا.</p></main></body></html>\n",
  "style.css": "body {margin:0;padding:1.5rem;background:#f5f5f5;color:#111;font-family:sans-serif;line-height:1.6}header,main {max-width:48rem;margin:auto}main p {font-size:1rem}body.cv-large-text main p {font-size:1.25rem}button {background:#eee;color:#111;padding:.5rem;border:1px solid #555}\n",
  "script.js": "const button=document.getElementById('cv-font-toggle');button.addEventListener('click',()=>{const active=document.body.classList.toggle('cv-large-text');button.setAttribute('aria-pressed',String(active));});\n"
}
