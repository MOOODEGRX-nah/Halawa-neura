{
 "index.html": "<!doctype html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>دليل الخدمات المحلي</title>\n<meta name=\"description\" content=\"دليل تجريبي محلي للخدمات مع تصفية حسب الفئة؛ بيانات للعرض فقط ويمكن استبدالها بخدماتك الفعلية.\">\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n<header><h1>دليل الخدمات</h1><p>بيانات تجريبية للعرض فقط، استبدلها بخدماتك الفعلية.</p></header>\n<main>\n<div id=\"service-filters\" role=\"group\" aria-label=\"تصفية الخدمات حسب الفئة\">\n<button type=\"button\" class=\"service-filter\" data-category=\"all\" aria-pressed=\"true\">الكل</button>\n<button type=\"button\" class=\"service-filter\" data-category=\"health\" aria-pressed=\"false\">الصحة</button>\n<button type=\"button\" class=\"service-filter\" data-category=\"education\" aria-pressed=\"false\">التعليم</button>\n<button type=\"button\" class=\"service-filter\" data-category=\"maintenance\" aria-pressed=\"false\">الصيانة</button>\n</div>\n<p id=\"service-count\" aria-live=\"polite\">عدد الخدمات المعروضة: 6</p>\n<ul id=\"service-list\">\n<li class=\"service-card\" data-category=\"health\"><h2>عيادة الحي</h2><p>وصف تجريبي: خدمة صحية مثال.</p></li>\n<li class=\"service-card\" data-category=\"health\"><h2>صيدلية مناوبة</h2><p>وصف تجريبي: خدمة صحية مثال.</p></li>\n<li class=\"service-card\" data-category=\"education\"><h2>مركز تعليمي</h2><p>وصف تجريبي: دروس مثال.</p></li>\n<li class=\"service-card\" data-category=\"education\"><h2>مكتبة عامة</h2><p>وصف تجريبي: مكتبة مثال.</p></li>\n<li class=\"service-card\" data-category=\"maintenance\"><h2>صيانة منزلية</h2><p>وصف تجريبي: صيانة مثال.</p></li>\n<li class=\"service-card\" data-category=\"maintenance\"><h2>كهربائي</h2><p>وصف تجريبي: صيانة مثال.</p></li>\n</ul>\n</main>\n</body>\n</html>\n",
 "style.css": "body{margin:0;font-family:sans-serif;background:#ffffff;color:#1a1a1a;line-height:1.6}\nheader,main{padding:1rem}\n#service-filters{display:flex;flex-wrap:wrap;gap:.5rem}\n.service-filter{padding:.5rem 1rem;border:2px solid #1f4e79;background:#ffffff;color:#1f4e79;border-radius:6px;cursor:pointer;transition:background-color .2s}\n.service-filter[aria-pressed=\"true\"]{background:#1f4e79;color:#ffffff}\n.service-filter:focus-visible{outline:3px solid #b35900;outline-offset:2px}\n#service-list{list-style:none;padding:0;display:grid;grid-template-columns:1fr;gap:1rem}\n.service-card{border:1px solid #cccccc;border-radius:6px;padding:1rem;background:#f5f5f5;transition:transform .2s}\n[hidden]{display:none}\n@media (min-width:600px){#service-list{grid-template-columns:repeat(3,1fr)}}\n@media (prefers-reduced-motion: reduce){*{transition:none!important;animation:none!important}}\n",
 "script.js": "const filters=document.querySelectorAll('.service-filter');\nconst cards=document.querySelectorAll('#service-list .service-card');\nconst count=document.getElementById('service-count');\nfilters.forEach(function(button){\n  button.addEventListener('click',function(){\n    const category=button.dataset.category;let shown=0;\n    filters.forEach(function(other){other.setAttribute('aria-pressed',other===button?'true':'false');});\n    cards.forEach(function(card){const match=category==='all'||card.dataset.category===category;card.hidden=!match;if(match)shown++;});\n    count.textContent='عدد الخدمات المعروضة: '+shown;\n  });\n});\n"
}