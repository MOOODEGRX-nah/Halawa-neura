# Export these in your shell. .env is not loaded implicitly.
# NEURA_MODELS_DIR=/absolute/path/to/Neura_Package/models
# NEURA_DATA_DIR=/absolute/path/to/private/neura-data
NEURA_N_CTX=4096
NEURA_N_GPU_LAYERS=-1
NEURA_N_THREADS=8
NEURA_TIMEOUT_S=180
# Optional: NEURA_TOKEN (otherwise generated in data/.api-token)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_ID=
# NEURA_WHISPER_CLI=/absolute/path/to/whisper-cli
# NEURA_WHISPER_MODEL=/absolute/path/to/whisper-large-v3.bin
# NEURA_PIPER_CLI=/absolute/path/to/piper
# NEURA_PIPER_MODEL=/absolute/path/to/ar_voice.onnx
# NEURA_PIPER_LANG=ar
